rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin';
    }
    // Allow read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Listing images — authenticated users can upload
    match /listings/{listingId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }
    
    // User avatars — only the user themselves
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Shop logos and banners
    match /shops/{shopId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /advertisements/{advertisementId}/{fileName} {
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // KYC documents — only the shop owner can upload private documents.
    match /kyc/{shopId}/{fileName} {
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/shops/$(shopId)).data.owner_id == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
  }
}
